{
  "expo": {
    "name": "SKYLOG",
    "slug": "skylog",
    "version": "1.1.7",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": {
      "url": "https://u.expo.dev/8309a845-efea-4e8c-b893-fd8aa030b6a6"
    },
    "scheme": "skylog",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/icon-light.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "bundleIdentifier": "com.motioncorrect.skylog",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCalendarsWriteOnlyAccessUsageDescription": "Add the selected flight to your calendar."
      },
      "appleTeamId": "9YYDX5K5KX",
      "buildNumber": "11"
    },
    "android": {
      "package": "com.konantian.skylog",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#0b151e"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f3f7fa",
          "image": "./assets/splash-flight-light.png",
          "dark": {
            "backgroundColor": "#0b151e",
            "image": "./assets/splash-flight.png"
          },
          "imageWidth": 200,
          "ios": {
            "imageWidth": 374
          },
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.motioncorrect.skylog",
          "bundleIdentifier": "com.motioncorrect.skylog.widgets",
          "enablePushNotifications": false,
          "widgets": [
            {
              "name": "SkylogNextFlight",
              "displayName": "SKYLOG · Next flight",
              "description": "Your next saved flight, available offline.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#12618d"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "SKYLOG uses calendars only when you choose to import or add flights.",
          "writeOnlyCalendarPermission": "Add the selected flight to your calendar.",
          "writeOnlyAccess": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "platforms": [
      "ios",
      "android"
    ],
    "owner": "yuan-space",
    "extra": {
      "eas": {
        "projectId": "8309a845-efea-4e8c-b893-fd8aa030b6a6"
      }
    }
  }
}
